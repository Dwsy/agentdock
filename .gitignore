.DS_Store
/workspace/
/AgentDock/

# 本地构建/运行产物。
# 仓库根目录可能放着当前 macOS 裸机运行的 agentdock 二进制，
# 以及带时间戳的回滚副本。它们只保留在本机；发布产物应放到
# dist/ 或外部发布系统，不进入 git。
/agentdock
/agentdock.new
/agentdock.new.*
/agentdock.prev
/agentdock.prev.*
/agentdock.bak*
/bin/
/dist/
/coverage.out
/*.test
/agentdock.killed*

# Web 仪表盘的 go:embed 产物。哈希文件名每次构建都变，入库只会制造噪音；
# 构建时由 packaging/macos/build-dashboard.sh 生成。仓库只保留 .gitkeep
# 让 go:embed 有占位文件（空目录会编译失败），此时控制台返回 404，
# 需先跑 make dashboard。
/internal/httpx/dashboard/dist/*
!/internal/httpx/dashboard/dist/.gitkeep

# Windows WPF 控制面板的本地构建产物。
/desktop/windows/control-panel/bin/
/desktop/windows/control-panel/obj/

# Python 辅助脚本的本地缓存不得进入 Skill 源码和发布包。
__pycache__/
*.py[cod]

# 本地部署密钥文件。
/.env
/agentdock.env
/cloudflared.env

# IDE
/.idea
.alma-snapshots
