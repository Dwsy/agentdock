# AgentDock 自身认证。公网 Tunnel 下必须设置。
AGENTDOCK_AUTH_TOKEN=replace-with-a-random-token

# Named Tunnel 使用固定 HTTPS Origin；Quick Tunnel 留空。
AGENTDOCK_SERVER_URL=https://agent.example.com

# 仅 Named Tunnel 需要。不要提交真实值。
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# 可选：宿主机发布端口，默认与容器内一致（8765）。
# AGENTDOCK_PUBLISH_PORT=8765

# 可选：浏览器自动化镜像。
# AGENTDOCK_IMAGE=ghcr.io/uvwt/agentdock:browser-latest
# AGENTDOCK_BROWSER_ENABLED=true

# 可选：手动推理桥接（/v1/responses + 精简 2 工具 /mcp/manual）。
# 桌面端与 Linux/Windows 运行时会在 agentdock.env 中持久保存以下配置：
# AGENTDOCK_MANUAL_LLM_ENABLED=false
# AGENTDOCK_MANUAL_LLM_PREVIEW_BYTES=1800
# AGENTDOCK_MANUAL_LLM_SLICE_BYTES=4096
# AGENTDOCK_MANUAL_LLM_MAX_SLICE_BYTES=16384
# AGENTDOCK_MANUAL_LLM_WAIT_MS=30000
# AGENTDOCK_MANUAL_LLM_MAX_WAIT_MS=55000
# AGENTDOCK_MANUAL_LLM_MAX_PENDING=32
# AGENTDOCK_MANUAL_LLM_CACHE_MAX_RESPONSES=256
# AGENTDOCK_MANUAL_LLM_CACHE_TTL_SEC=1800
# AGENTDOCK_MANUAL_LLM_KEEPALIVE_MS=15000
# AGENTDOCK_MANUAL_LLM_CACHE_MAX_IMAGE_MB=32
